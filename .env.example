# ==============================================================================
# VYAVSAYMITRA — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development environment.
# NEVER commit your real API keys or secrets to version control.
# ==============================================================================

# Frontend Application Configuration
# Optional backend API base URL (defaults to client-side mode if empty)
VITE_API_URL=http://localhost:5000

# AI Advisory Service (Google Gemini)
# Optional: Provide a valid Gemini API key to enable live AI responses in AI Mitra.
# If omitted, AI Mitra operates in offline mode with its built-in rural business advisory engine.
VITE_GEMINI_API_KEY=
