# ==============================================================================
# VYAVSAYMITRA — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development environment.
# NEVER commit your real API keys or secrets to version control.
# ==============================================================================

# Frontend Application Configuration
# Optional backend API base URL (defaults to client-side mode if empty)
VITE_API_URL=http://localhost:5000

# AI Advisory Service (Google Gemini)
# Provide a valid Gemini API key to enable live AI responses in AI Mitra & qualitative advisory.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Government Market Data API (data.gov.in / AGMARKNET)
# Optional: Provide an official data.gov.in API key to enable live daily Mandi spot price fetching.
# Obtain from: https://data.gov.in (Register -> My Account -> API Key)
# Resource: "Current Daily Mandi Price Bulletin" (Resource ID: 9ef84268-d588-465a-a308-a864a43d0070)
# If omitted or invalid, VYAVSAYMITRA safely falls back to verified local AGMARKNET benchmark data.
DATAGOV_API_KEY=

