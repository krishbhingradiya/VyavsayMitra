# ==============================================================================
# VYAVSAYMITRA Server — Environment Configuration
# ==============================================================================
# Copy this file to .env inside the server/ directory.
# NEVER commit your real credentials to version control.
# ==============================================================================

# Server Port
PORT=5000

# SMTP Email Configuration
# Required to send real OTP emails. Without these, OTPs are logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VYAVSAYMITRA <noreply@vyavsaymitra.com>

# OTP Secret — Used to HMAC-hash OTPs before storage.
# CHANGE THIS to a long random string in production!
OTP_SECRET=change-this-to-a-long-random-secret-string
