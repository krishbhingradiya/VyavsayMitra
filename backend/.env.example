# ==============================================================================
# VYAVSAYMITRA Server — Environment Configuration
# ==============================================================================
# Copy this file to .env inside the server/ directory.
# NEVER commit your real credentials to version control.
# ==============================================================================

# Server Port
PORT=5000

# SMTP Email Configuration
# Required to send real OTP emails. Without these, OTPs are logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VYAVSAYMITRA <noreply@vyavsaymitra.com>

# OTP Secret — Used to HMAC-hash OTPs before storage.
# CHANGE THIS to a long random string in production!
OTP_SECRET=change-this-to-a-long-random-secret-string

# AI Advisory Service (Google Gemini)
# Provide a valid Gemini API key for qualitative narrative synthesis and explanations.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Government Market Data API (data.gov.in / AGMARKNET)
# Optional: Provide an official data.gov.in API key for live daily Mandi spot price fetching.
# Obtain from: https://data.gov.in (Register -> My Account -> API Key)
# Resource: "Current Daily Mandi Price Bulletin" (Resource ID: 9ef84268-d588-465a-a308-a864a43d0070)
# If omitted or invalid, VYAVSAYMITRA safely falls back to verified local AGMARKNET benchmark data.
DATAGOV_API_KEY=

