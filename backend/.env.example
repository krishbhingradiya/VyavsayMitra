# ==============================================================================
# VYAVSAYMITRA Server — Environment Configuration
# ==============================================================================
# Copy this file to .env inside the backend/ directory:
#   cp .env.example .env
# NEVER commit your real credentials or secrets to version control.
# ==============================================================================

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Production Primary)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API:
# - Project URL: https://xyzcompany.supabase.co
# - service_role secret: eyJhbGciOi... (Keep strictly secret on server-side!)
# NOTE: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# SMTP Email Configuration
# ------------------------------------------------------------------------------
# Required to send real OTP emails. Without these, OTPs are logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VYAVSAYMITRA <noreply@vyavsaymitra.com>

# ------------------------------------------------------------------------------
# Authentication Secret
# ------------------------------------------------------------------------------
# Used to HMAC-hash OTPs and sign session tokens.
# CHANGE THIS to a long random string in production!
OTP_SECRET=change-this-to-a-long-random-secret-string
JWT_SECRET=change-this-to-a-long-random-jwt-secret-string

# ------------------------------------------------------------------------------
# AI Advisory Service (Google Gemini)
# ------------------------------------------------------------------------------
# Provide a valid Gemini API key for qualitative narrative synthesis and explanations.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Government Market Data API (data.gov.in / AGMARKNET)
# ------------------------------------------------------------------------------
# Optional: Provide an official data.gov.in API key for live daily Mandi spot price fetching.
# Obtain from: https://data.gov.in (Register -> My Account -> API Key)
# Resource: "Current Daily Mandi Price Bulletin" (Resource ID: 9ef84268-d588-465a-a308-a864a43d0070)
# If omitted or invalid, VYAVSAYMITRA safely falls back to verified local AGMARKNET benchmark data.
DATAGOV_API_KEY=
